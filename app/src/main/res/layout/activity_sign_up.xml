<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/sign_up"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#1A1A1A"
        android:layout_marginBottom="12dp" />

    <!-- Name field -->
    <EditText
        android:id="@+id/etName"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:autofillHints=""
        android:background="@drawable/bg_input_field"
        android:paddingHorizontal="12dp"
        android:hint="@string/name"
        android:textColorHint="#666666"
        android:textColor="#1A1A1A"
        android:textSize="14sp"
        android:inputType="textPersonName"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/tvNameError"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="-8dp"
        android:layout_marginBottom="12dp"
        android:text="@string/please_enter_your_name"
        android:textColor="#B00021"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- Email field + inline error -->
    <EditText
        android:id="@+id/etEmail"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:autofillHints=""
        android:background="@drawable/bg_input_field"
        android:paddingHorizontal="12dp"
        android:hint="@string/email"
        android:textColorHint="#666666"
        android:textColor="#1A1A1A"
        android:textSize="14sp"
        android:inputType="textEmailAddress" />

    <TextView
        android:id="@+id/tvEmailError"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="12dp"
        android:text="@string/please_enter_a_valid_email_address"
        android:textColor="#B00021"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- Password field -->
    <EditText
        android:id="@+id/etPassword"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:autofillHints=""
        android:background="@drawable/bg_input_field"
        android:paddingHorizontal="12dp"
        android:hint="@string/password"
        android:textColorHint="#666666"
        android:textColor="#1A1A1A"
        android:textSize="14sp"
        android:inputType="textPassword"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/tvPasswordError"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="-8dp"
        android:layout_marginBottom="16dp"
        android:text="@string/password_must_be_at_least_6_characters"
        android:textColor="#B00021"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- Create Account button -->
    <Button
        android:id="@+id/btnCreateAccount"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/bg_button_teal"
        android:text="@string/create_account"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textAllCaps="false"
        android:textStyle="normal"
        android:elevation="0dp"
        android:stateListAnimator="@null" />

    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleSmall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:visibility="gone" />

</LinearLayout>