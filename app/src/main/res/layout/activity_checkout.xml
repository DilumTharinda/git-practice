<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/checkout"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#1A1A1A"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/tvItemName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/quickcart_item"
        android:textSize="15sp"
        android:textColor="#1A1A1A" />

    <TextView
        android:id="@+id/tvPrice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/lkr_2_500_00"
        android:textSize="15sp"
        android:textColor="#1A1A1A"
        android:layout_marginBottom="16dp" />

    <!-- Quantity row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/quantity"
            android:textSize="14sp"
            android:textColor="#1A1A1A" />

        <Button
            android:id="@+id/btnMinus"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_square_button"
            android:text="-"
            android:textColor="#1A1A1A"
            android:textSize="16sp"
            android:textAllCaps="false"
            android:padding="0dp"
            android:elevation="0dp"
            android:stateListAnimator="@null" />

        <TextView
            android:id="@+id/tvQuantity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:text="@string/_1"
            android:textSize="15sp"
            android:textColor="#1A1A1A" />

        <Button
            android:id="@+id/btnPlus"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_square_button"
            android:text="+"
            android:textColor="#1A1A1A"
            android:textSize="16sp"
            android:textAllCaps="false"
            android:padding="0dp"
            android:elevation="0dp"
            android:stateListAnimator="@null" />

    </LinearLayout>

    <!-- Spacer pushes Pay Now into the bottom reach zone, matching the Figma frame -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <Button
        android:id="@+id/btnPayNow"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/bg_button_teal"
        android:text="@string/pay_now"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textAllCaps="false"
        android:elevation="0dp"
        android:stateListAnimator="@null" />

</LinearLayout>